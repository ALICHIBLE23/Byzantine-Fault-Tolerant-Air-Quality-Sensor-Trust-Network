      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(tm_truth{region=\"$region\"})",
          "legendFormat": "ground truth"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(tm_agg_estimate{region=\"$region\", algorithm=\"trustmesh\"})",
          "legendFormat": "trustmesh"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(tm_agg_estimate{region=\"$region\", algorithm=\"mean\"})",
          "legendFormat": "mean"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(tm_agg_estimate{region=\"$region\", algorithm=\"median\"})",
          "legendFormat": "median"
